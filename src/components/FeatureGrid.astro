---
import { type Locale, type StringKey, t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const features = ['shell', 'desks', 'glass', 'compositor', 'toolkit', 'apps'] as const;
---

<div class="grid">
  {features.map((name) => (
    <article>
      <h3>{t(locale, `features.${name}.title` as StringKey)}</h3>
      <p>{t(locale, `features.${name}.body` as StringKey)}</p>
    </article>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 56px 48px;
  }

  h3 {
    margin: 0 0 8px;
    font-size: 1.0625rem;
  }

  p {
    margin: 0;
    color: var(--secondary-text);
  }
</style>
