---
import Base from '../../layouts/Base.astro';
import { type Locale, localeStaticPaths, t } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<Base locale={locale} title={t(locale, 'about.title')}>
  <div class="container">
    <header class="page-header">
      <h1>{t(locale, 'about.title')}</h1>
      <p>{t(locale, 'about.lead')}</p>
    </header>
    <div class="prose">
      <p>{t(locale, 'about.body')}</p>
      <h2>{t(locale, 'about.officialTitle')}</h2>
      <p>{t(locale, 'about.officialBody')}</p>
      <a class="button button-primary" href="https://github.com/cutefishos" target="_blank" rel="noopener">{t(locale, 'about.contribute')}</a>
      <h2 id="support">{t(locale, 'about.supportTitle')}</h2>
      <p>{t(locale, 'about.supportBody')}</p>
      <a class="button button-primary" href="https://github.com/sponsors/cutefishos" target="_blank" rel="noopener">{t(locale, 'about.sponsor')}</a>
    </div>
  </div>
</Base>
