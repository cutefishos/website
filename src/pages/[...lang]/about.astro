---
import Base from '../../layouts/Base.astro';
import { type Locale, localePath, localeStaticPaths, t } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<Base locale={locale} title={t(locale, 'about.title')}>
  <div class="container">
    <header class="page-header">
      <h1>{t(locale, 'about.title')}</h1>
      <p>{t(locale, 'about.lead')}</p>
    </header>
    <div class="prose">
      <p>{t(locale, 'about.body')}</p>

      <h2>{t(locale, 'about.openTitle')}</h2>
      <p>{t(locale, 'about.openBody')}</p>
      <ul>
        <li>{t(locale, 'about.licenseBsd')}</li>
        <li>{t(locale, 'about.licenseGpl')}</li>
        <li>{t(locale, 'about.licenseWallpapers')}</li>
      </ul>

      <h2>{t(locale, 'about.buildTitle')}</h2>
      <p>{t(locale, 'about.buildBody')}</p>
      <ul>
        <li>{t(locale, 'about.buildFresh')}</li>
        <li>{t(locale, 'about.buildSign')}</li>
        <li>{t(locale, 'about.buildTrace')}</li>
      </ul>
      <p>{t(locale, 'about.buildCheck')}</p>
      <div class="actions">
        <a class="button button-primary" href="https://download.cutefish.org/" target="_blank" rel="noopener">{t(locale, 'about.downloads')}</a>
        <a class="button button-secondary" href={localePath(locale, '/blog/how-cutefish-is-built')}>{t(locale, 'about.buildGuide')}</a>
      </div>

      <h2 id="support">{t(locale, 'about.involvedTitle')}</h2>
      <p>{t(locale, 'about.involvedBody')}</p>
      <div class="actions">
        <a class="button button-primary" href="https://github.com/sponsors/cutefishos" target="_blank" rel="noopener">{t(locale, 'about.sponsor')}</a>
        <a class="button button-secondary" href="https://github.com/cutefishos" target="_blank" rel="noopener">{t(locale, 'about.contribute')}</a>
      </div>
    </div>
  </div>
</Base>

<style>
  ul {
    margin: 12px 0;
    padding-left: 1.25em;
  }

  li + li {
    margin-top: 4px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
</style>
