---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import desktop from '../../assets/desktop.png';
import { type Locale, localeStaticPaths, t } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://cutefish.org/#organization',
      name: 'Cutefish',
      alternateName: 'CutefishOS',
      url: 'https://cutefish.org/',
      sameAs: [
        'https://github.com/cutefishos',
        'https://x.com/cutefishos',
        'https://github.com/sponsors/cutefishos',
      ],
    },
    {
      '@type': 'WebSite',
      name: 'Cutefish',
      alternateName: 'CutefishOS',
      url: 'https://cutefish.org/',
      publisher: { '@id': 'https://cutefish.org/#organization' },
    },
  ],
};
---

<Base locale={locale} structuredData={structuredData}>
  <section class="hero container">
    <div class="hero-text">
      <h1>{t(locale, 'home.title')}</h1>
      <p class="lead">{t(locale, 'home.lead')}</p>
      <div class="actions">
        <a class="button button-primary" href="https://github.com/cutefishos" target="_blank" rel="noopener">{t(locale, 'home.primary')}</a>
        <a class="button button-secondary" href="https://github.com/cutefishos/getting-started" target="_blank" rel="noopener">{t(locale, 'home.secondary')}</a>
      </div>
    </div>

    <Image
      class="screenshot"
      src={desktop}
      alt={t(locale, 'home.screenshotAlt')}
      widths={[640, 1080, 1600, 2160]}
      sizes="(max-width: 899px) calc(100vw - 48px), 640px"
      loading="eager"
    />
  </section>

  <section class="container highlights">
    <FeatureGrid locale={locale} />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: center;
    padding-top: 40px;
  }

  h1 {
    margin: 0 0 20px;
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    letter-spacing: -0.025em;
    text-wrap: wrap;
  }

  .lead {
    margin: 0 0 36px;
    color: var(--secondary-text);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-top: 24px;
      text-align: center;
    }

    .screenshot {
      order: -1;
    }

    .hero-text {
      margin: 0 auto;
      max-width: 560px;
    }

    .lead {
      text-wrap: balance;
    }

    .actions {
      justify-content: center;
    }
  }

  .screenshot {
    display: block;
    width: 100%;
    border-radius: var(--medium-radius);
    box-shadow:
      0 0 0 1px var(--separator),
      0 24px 48px -12px var(--shadow);
  }

  .highlights {
    padding-top: 120px;
    padding-bottom: 120px;
  }
</style>
