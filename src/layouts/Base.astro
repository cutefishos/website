---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import desktop from '../assets/desktop.png';
import { type Locale, t } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  published?: Date;
  structuredData?: object;
}

const { locale, title, description = t(locale, 'site.description'), published, structuredData } = Astro.props;
const pageTitle = title ? `${title} - Cutefish` : t(locale, 'site.title');
const canonical = new URL(Astro.url.pathname, Astro.site);
const card = await getImage({ src: desktop, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' });
const cardUrl = new URL(card.src, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Cutefish" href="/rss.xml" />
    <meta property="og:site_name" content="Cutefish" />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(locale, 'home.screenshotAlt')} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@cutefishos" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
